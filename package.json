{
  "name": "zeiteisen",
  "version": "1.2.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run messages && tsc -b && npm run skill && vite build",
    "messages": "paraglide-js compile --project ./project.inlang --outdir ./generated/paraglide --emit-ts-declarations",
    "prepare": "npm run messages && npm run hooks",
    "hooks": "git config core.hooksPath .githooks || true",
    "lint": "oxlint",
    "fmt": "oxfmt src",
    "preview": "vite preview",
    "schema": "node scripts/json-schema.mjs",
    "schema:timetable": "node scripts/json-schema.mjs timetable",
    "schema:dates": "node scripts/json-schema.mjs dates",
    "test": "vitest run",
    "test:watch": "vitest",
    "schema:locations": "node scripts/json-schema.mjs locations",
    "schema:degree": "node scripts/json-schema.mjs degree",
    "schema:catalog": "node scripts/json-schema.mjs catalog",
    "catalog": "node scripts/catalog-index.mjs",
    "skill": "node scripts/skill.mjs",
    "remote": "ssh -p 2222 root@server.example.org \"sudo -i -u caddy --\"",
    "upload": "git bundle create - HEAD main | ssh -p 2222 root@server.example.org 'b=$(mktemp) && cat > $b && chmod 644 $b && rm -rf /home/caddy/.local/state/zeiteisen && sudo -u caddy git clone -q $b /home/caddy/.local/state/zeiteisen; s=$?; rm -f $b; exit $s'",
    "publish": "npm run remote -- 'just zeiteisen publish'",
    "catalog-remote": "npm run remote -- 'just zeiteisen catalog'"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@inlang/paraglide-js": "^2.25.4",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "date-fns": "^4.4.0",
    "ics": "^3.12.0",
    "lucide-react": "^1.47.0",
    "ohash": "^2.0.12",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "ufo": "^1.6.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "fflate": "^0.8.3",
    "jiti": "^2.7.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "glob": "^13.0.6"
  }
}
