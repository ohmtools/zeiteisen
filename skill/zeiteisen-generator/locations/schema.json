{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "locations": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "mapsUrl": {
            "type": "string",
            "format": "uri"
          },
          "siteUrl": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "code"
        ]
      }
    }
  }
}
